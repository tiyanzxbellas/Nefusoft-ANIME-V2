{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://apisoft.tiyan.my.id/v1/:path*"
    },
    {
      "source": "/(.*\\.mp4)",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "(?<url>.*)"
        }
      ],
      "destination": "https://apisoft.tiyan.my.id/v1/p/legacy.mp4?url=:url"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
